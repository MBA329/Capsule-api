// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  capsules     Capsule[]?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  refreshToken String
}

model Capsule{
    id        Int      @id @default(autoincrement())
  title     String
  content   String?
  owner    User     @relation(fields: [ownerId], references: [id])
  ownerId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}